{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'local>hivemq/renovate-config:default.json5',
    ],
    baseBranchPatterns: [
        'master',
    ],
    useBaseBranchConfig: 'merge',
    branchPrefix: 'renovate/hivemq-oci-version-catalog-gradle-plugin/',
    addLabels: [
        'integrations-team-coordination',
    ],
    packageRules: [
        {
            description: 'the gradle-oci version in build.gradle.kts is pinned to test the compatibility error, only the version catalog entry is updated',
            matchManagers: ['gradle'],
            matchFileNames: ['build.gradle.kts'],
            matchPackageNames: ['io.github.sgtsilvio.gradle:gradle-oci'],
            enabled: false,
        },
    ],
}
